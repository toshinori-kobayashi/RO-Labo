# /srv/ro-server/app/.env の雛形。
# 実体は EC2 上で scripts/init-env.sh が自動生成する（mode 0600 / owner ec2-user）。
# このファイルは配置されるだけで読み込まれない。実際の秘密値は絶対にコミットしないこと。

# --- config.env 由来（init-env.sh が同期。ここを編集しても意味はない） ---
RATHENA_COMMIT=e985006171d2eb320ee512a653f4c83aea3d81b6
PACKETVER=20211103
SERVER_NAME=rAthena-PreRE
MARIADB_IMAGE=mariadb:11.4
MARIADB_DATABASE=ragnarok
MARIADB_USER=ragnarok
AWS_REGION=ap-northeast-1
CW_LOG_GROUP=legacy-app-lab-containers-cw-verify
TZ=Asia/Tokyo
COMPOSE_PROJECT_NAME=ro-server

# --- 秘密（init-env.sh が openssl rand で生成。英数字のみ） ---
MARIADB_ROOT_PASSWORD=
MARIADB_PASSWORD=
# inter-server 認証（rAthena の userid/passwd は 23 文字上限）
INTERSERVER_USER=
INTERSERVER_PASSWORD=

# --- 実行時に update-public-ip.sh が IMDSv2 から取得して書き込む ---
PUBLIC_IP=
