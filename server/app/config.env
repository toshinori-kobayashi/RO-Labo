# 非秘密の設定（Git 管理・単一の真実）
# scripts/init-env.sh がこの内容を /srv/ro-server/app/.env に同期する。
# 値を変えたら再デプロイ（deploy.sh）で .env に反映される。

# rAthena の固定コミット（Docker build arg）
RATHENA_COMMIT=e985006171d2eb320ee512a653f4c83aea3d81b6
# 対応クライアント（kRO 2021-11-03 RagexeRE 系）。変更時は再ビルドが必要
PACKETVER=20211103
# クライアントのサーバ一覧に出る名前
# 注意: 空白や \ / : * ? " < > | を含めるとクライアント側でギルドエンブレムが動かない
SERVER_NAME=rAthena-PreRE

MARIADB_IMAGE=mariadb:11.4
MARIADB_DATABASE=ragnarok
MARIADB_USER=ragnarok

AWS_REGION=ap-northeast-1
CW_LOG_GROUP=legacy-app-lab-containers-cw-verify

TZ=Asia/Tokyo
COMPOSE_PROJECT_NAME=ro-server
