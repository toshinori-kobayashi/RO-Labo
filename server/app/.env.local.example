# ローカル（Mac / colima）検証用の .env 雛形。
#
#   cd app && cp .env.local.example .env
#   docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
#
# ここに書いてある秘密値はローカル検証専用のダミー。EC2 では使わないこと
# （EC2 上の .env は scripts/init-env.sh が openssl rand で生成する）。
# .env は .gitignore 済み。

# --- config.env と同じ値（ローカルでもビルド条件を揃える） ---
RATHENA_COMMIT=e985006171d2eb320ee512a653f4c83aea3d81b6
PACKETVER=20211103
SERVER_NAME=rAthena-PreRE
MARIADB_IMAGE=mariadb:11.4
MARIADB_DATABASE=ragnarok
MARIADB_USER=ragnarok
TZ=Asia/Tokyo
COMPOSE_PROJECT_NAME=ro-server-local

# --- awslogs は local override で json-file に差し替わるが、
#     本体 docker-compose.yml の変数補間のために定義だけしておく ---
AWS_REGION=ap-northeast-1
CW_LOG_GROUP=unused-in-local

# --- ローカル専用ダミー秘密値（英数字のみ。本番と共有しないこと） ---
MARIADB_ROOT_PASSWORD=localrootpw0000
MARIADB_PASSWORD=localragnarokpw0
INTERSERVER_USER=localinter
INTERSERVER_PASSWORD=localinterpw0000

# --- ローカルではクライアントから見た接続先を loopback にする ---
PUBLIC_IP=127.0.0.1
